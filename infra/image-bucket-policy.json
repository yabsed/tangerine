{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicImageRead",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::dangeun-images-8c4e6a29/images/*"
    },
    {
      "Sid": "RequireHTTPS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::dangeun-images-8c4e6a29",
        "arn:aws:s3:::dangeun-images-8c4e6a29/*"
      ],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}
